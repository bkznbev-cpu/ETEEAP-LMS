# Laravel settings for the HOSTED server (see HOSTINGER.md).
# Copy to backend/.env on the server and fill in the values marked <...>.
# Never commit the real backend/.env.

APP_NAME="MPSU ETEEAP LMS"
APP_ENV=production
# Created by hostinger/install.sh if left empty.
# Keep it: changing it signs everyone out.
APP_KEY=
# Must stay false on a server other people can reach: debug pages show
# source code, file paths and settings.
APP_DEBUG=false
# The site's address. The API and uploads are under it (/api, /storage).
APP_URL=https://<your-domain>
FRONTEND_URL=https://<your-domain>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# From hPanel -> Databases -> MySQL Databases (the names start with u..._).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<u123456789_siknayan>
DB_USERNAME=<u123456789_siknayan>
DB_PASSWORD=<database password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Email: verification codes, password reset codes, notices.
# Gmail needs 2-Step Verification and an App Password (not the normal password).
# Gmail sends at most about 500 emails a day; for more, use a mail service.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=mpsueteeaplms@gmail.com
MAIL_PASSWORD=<16-character app password>
MAIL_FROM_ADDRESS=mpsueteeaplms@gmail.com
MAIL_FROM_NAME="MPSU ETEEAP LMS"

# Minutes before a login expires (480 = 8 hours).
SANCTUM_TOKEN_EXPIRATION=480

# Refuse emails whose domain does not exist (needs internet on the server).
SIKNAYAN_CHECK_EMAIL_DOMAINS=true

# Hostinger Web Hosting has no proxy in front: trust none.
TRUSTED_PROXIES=
