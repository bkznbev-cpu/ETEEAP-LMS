# Used by docker-compose.yml and docker-compose.prod.yml.
# Copy to .env and choose your own passwords.
# .env is ignored by git; never commit it.
MYSQL_DATABASE=siknayan
MYSQL_USER=siknayan
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Hosted server only (docker-compose.prod.yml): the site's domain name,
# e.g. lms.mpsu.edu.ph. It must already point at the server.
SITE_DOMAIN=
